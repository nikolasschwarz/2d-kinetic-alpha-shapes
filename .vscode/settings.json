{
  "cmake.useCMakePresets": "always",
  "cmake.configurePreset": "vcpkg-x64",
  "cmake.buildPreset": "vcpkg-x64-release",
  "cmake.configureOnOpen": true,
  "cmake.useVsDeveloperEnvironment": "always",
  "cmake.buildBeforeRun": false,
  "cmake.debugConfig": {
    "cwd": "${workspaceFolder}",
    "program": "${workspaceFolder}/build-debug/bin/kinDS-demo.exe",
    "args": ["--mesh", "input_examples/test_oak_2.txt", "--export-mode", "combined"],
    "console": "internalConsole",
    "preLaunchTask": "Build kinDS-demo if needed"
  },
  "debug.openDebug": "openOnSessionStart"
}
