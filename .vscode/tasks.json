{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build kinDS-demo if needed",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/scripts/build-demo-if-needed.ps1",
        "-WorkspaceFolder",
        "${workspaceFolder}"
      ],
      "group": "build",
      "problemMatcher": ["$msCompile"],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "close": true
      }
    }
  ]
}
