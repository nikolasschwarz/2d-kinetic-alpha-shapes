{
  "version": 5,
  "configurePresets": [
    {
      "name": "vcpkg-x64",
      "displayName": "vcpkg (x64) - MSVC",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "C:/src/vcpkg/scripts/buildsystems/vcpkg.cmake"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vcpkg-x64-debug",
      "configurePreset": "vcpkg-x64",
      "configuration": "Debug",
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "debuggerCommandArguments": "--demo",
          "debuggerWorkingDirectory": "${sourceDir}"
        }
      }
    },
    {
      "name": "vcpkg-x64-release",
      "configurePreset": "vcpkg-x64",
      "configuration": "Release"
    }
  ]
}